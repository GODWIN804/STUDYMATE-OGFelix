</div>


<div class="toast" id="toast"></div>


<script>

/* =========================
   STUDYMATE DATA
========================= */

const subjects = [

{
name:"Biology",
icon:"🧬",
progress:65,
description:"Life processes, cells, genetics, ecology and human biology."
},

{
name:"Chemistry",
icon:"⚗️",
progress:72,
description:"Atoms, bonding, reactions, organic chemistry and calculations."
},

{
name:"Mathematics",
icon:"📐",
progress:80,
description:"Algebra, functions, calculus, statistics and geometry."
},

{
name:"Physics",
icon:"⚡",
progress:58,
description:"Mechanics, electricity, waves, energy and measurements."
},

{
name:"English",
icon:"📚",
progress:70,
description:"Grammar, comprehension, writing and communication."
},

{
name:"ICT",
icon:"💻",
progress:62,
description:"Computer systems, programming, databases and digital skills."
},

{
name:"Geography",
icon:"🌍",
progress:55,
description:"Physical geography, human geography and environmental studies."
},

{
name:"History",
icon:"🏛️",
progress:50,
description:"Historical events, societies, leadership and change."
}

];


/* =========================
   SUBJECT DISPLAY
========================= */

function createSubjectCard(subject){

return `
<div class="subject" onclick="openSubject('${subject.name}')">

<div class="subject-icon">${subject.icon}</div>

<h3>${subject.name}</h3>

<p>${subject.description}</p>

<div class="progress">
<div style="width:${subject.progress}%"></div>
</div>

<small style="color:var(--muted);display:block;margin-top:7px">
${subject.progress}% complete
</small>

</div>
`;

}

function loadSubjects(){

document.getElementById("dashboardSubjects").innerHTML =
subjects.slice(0,4).map(createSubjectCard).join("");

document.getElementById("allSubjects").innerHTML =
subjects.map(createSubjectCard).join("");

document.getElementById("progressSubjects").innerHTML =
subjects.map(s=>`

<div style="margin:15px 0">

<div style="display:flex;justify-content:space-between">
<b>${s.icon} ${s.name}</b>
<span>${s.progress}%</span>
</div>

<div class="progress">
<div style="width:${s.progress}%"></div>
</div>

</div>

`).join("");

}

loadSubjects();


/* =========================
   LESSONS
========================= */

const lessons = [

{
title:"Transport in Humans",
subject:"Biology",
icon:"❤️",
description:"Understand the circulatory system, blood and transport."
},

{
title:"Cell Structure",
subject:"Biology",
icon:"🔬",
description:"Study organelles and their functions."
},

{
title:"Atomic Structure",
subject:"Chemistry",
icon:"⚛️",
description:"Learn about protons, neutrons, electrons and isotopes."
},

{
title:"Chemical Bonding",
subject:"Chemistry",
icon:"🧪",
description:"Explore ionic, covalent and metallic bonding."
},

{
title:"Quadratic Equations",
subject:"Mathematics",
icon:"📐",
description:"Solve quadratic equations using different methods."
},

{
title:"Differentiation",
subject:"Mathematics",
icon:"∫",
description:"Introduction to differentiation and applications."
},

{
title:"Motion",
subject:"Physics",
icon:"🚗",
description:"Study displacement, velocity and acceleration."
},

{
title:"Electricity",
subject:"Physics",
icon:"🔌",
description:"Understand current, voltage, resistance and circuits."
}

];


document.getElementById("lessonGrid").innerHTML =
lessons.map(l=>`

<div class="lesson">

<div style="font-size:30px">${l.icon}</div>

<small style="color:var(--primary)">${l.subject}</small>

<h3>${l.title}</h3>

<p>${l.description}</p>

<button onclick="openLesson('${l.title}')">
Read Notes
</button>

</div>

`).join("");


/* =========================
   NOTES
========================= */

const notes = {

"Transport in Humans":`

<h1>❤️ Transport in Humans</h1>

<div class="note-content">

<h2>1. Why transport is necessary</h2>

<p>
Large multicellular organisms require transport systems because many cells
are too far from the body surface for substances to reach them efficiently
by diffusion alone.
</p>

<h2>2. The circulatory system</h2>

<p>
The human circulatory system consists mainly of the heart, blood and blood
vessels.
</p>

<h3>The heart</h3>

<ul>
<li>Right atrium</li>
<li>Right ventricle</li>
<li>Left atrium</li>
<li>Left ventricle</li>
</ul>

<h3>Blood vessels</h3>

<ul>
<li><b>Arteries:</b> carry blood away from the heart.</li>
<li><b>Veins:</b> carry blood toward the heart.</li>
<li><b>Capillaries:</b> allow exchange between blood and tissues.</li>
</ul>

<h2>3. Components of blood</h2>

<ul>
<li>Red blood cells — transport oxygen.</li>
<li>White blood cells — involved in defence.</li>
<li>Platelets — help blood clot.</li>
<li>Plasma — transports dissolved substances.</li>
</ul>

<h2>4. Double circulation</h2>

<p>
Humans have a double circulatory system. Blood passes through the heart
twice during one complete circulation around the body.
</p>

<h2>Exam Tip</h2>

<p>
When answering transport questions, connect the structure to its function
and explain how the feature helps the process occur efficiently.
</p>

</div>
`,

"Cell Structure":`

<h1>🔬 Cell Structure</h1>

<div class="note-content">

<h2>Cell theory</h2>

<ul>
<li>Living organisms are composed of cells.</li>
<li>The cell is the basic structural and functional unit of life.</li>
<li>New cells arise from existing cells.</li>
</ul>

<h2>Important organelles</h2>

<ul>
<li><b>Nucleus:</b> contains genetic material.</li>
<li><b>Mitochondrion:</b> site of aerobic respiration.</li>
<li><b>Ribosome:</b> protein synthesis.</li>
<li><b>Cell membrane:</b> controls movement of substances.</li>
<li><b>Chloroplast:</b> site of photosynthesis in plants.</li>
<li><b>Vacuole:</b> contains cell sap in plant cells.</li>
</ul>

</div>
`,

"Atomic Structure":`

<h1>⚛️ Atomic Structure</h1>

<div class="note-content">

<h2>Subatomic particles</h2>

<ul>
<li>Protons have positive charge.</li>
<li>Electrons have negative charge.</li>
<li>Neutrons have no charge.</li>
</ul>

<h2>Atomic number</h2>

<p>
The atomic number is the number of protons in the nucleus of an atom.
</p>

<h2>Mass number</h2>

<p>
Mass number = number of protons + number of neutrons.
</p>

<h2>Isotopes</h2>

<p>
Isotopes are atoms of the same element with the same number of protons
but different numbers of neutrons.
</p>

</div>
`,

"Quadratic Equations":`

<h1>📐 Quadratic Equations</h1>

<div class="note-content">

<h2>General form</h2>

<p><b>ax² + bx + c = 0</b></p>

<h2>Methods of solving</h2>

<ul>
<li>Factorisation</li>
<li>Completing the square</li>
<li>Quadratic formula</li>
</ul>

<h2>Quadratic formula</h2>

<p>
x = (-b ± √(b² − 4ac)) / 2a
</p>

<h2>Discriminant</h2>

<p>
The discriminant is b² − 4ac.
</p>

</div>
`

};


function openLesson(title){

document.getElementById("noteContent").innerHTML =
notes[title] || `

<h1>${title}</h1>

<div class="note-content">

<h2>Study Notes</h2>

<p>
Detailed StudyMate notes for this topic will be available here.
Teachers can later upload and update lesson materials.
</p>

<h2>Study Method</h2>

<ul>
<li>Read the concept carefully.</li>
<li>Write short summary notes.</li>
<li>Attempt practice questions.</li>
<li>Take the related quiz.</li>
</ul>

</div>
`;

document.getElementById("noteModal").classList.add("show");

}


/* =========================
   PAPERS
========================= */

function openPaper(subject){

let questions = {

Biology:[
"Explain why the human circulatory system is described as a double circulation.",
"Describe two adaptations of red blood cells for oxygen transport.",
"Explain how exercise can affect pulse rate.",
"Distinguish between arteries, veins and capillaries."
],

Chemistry:[
"Define an isotope.",
"Explain why isotopes of an element have similar chemical properties.",
"Calculate the number of neutrons in an atom with mass number 65 and atomic number 29.",
"State two differences between ionic and covalent bonding."
],

Mathematics:[
"Solve x² − 5x + 6 = 0.",
"Find the gradient of y = 3x + 5.",
"Differentiate y = x³ + 2x².",
"Simplify (x² − 9)/(x − 3)."
],

Physics:[
"Define velocity.",
"State Newton's second law of motion.",
"Explain the difference between mass and weight.",
"State Ohm's law."
]

};

document.getElementById("paperContent").innerHTML=`

<h1>${subject} Practice Questions</h1>

<p style="color:var(--muted);margin:10px 0 20px">
Attempt the questions without looking at your notes first.
</p>

${questions[subject].map((q,i)=>`

<div class="card" style="margin:12px 0;background:var(--bg)">
<b>Question ${i+1}</b>

<p style="margin-top:8px;line-height:1.6">${q}</p>

</div>

`).join("")}

<button class="btn btn-blue"
onclick="closeModal('paperModal');showPage('quiz')">
Take Related Quiz
</button>

`;

document.getElementById("paperModal").classList.add("show");

}


/* =========================
   QUIZ
========================= */

const quizQuestions=[

{
q:"Which blood vessel carries blood away from the heart?",
options:["Vein","Artery","Capillary","Venule"],
answer:1
},

{
q:"What is the atomic number of an element?",
options:[
"Number of neutrons",
"Number of electrons and neutrons",
"Number of protons",
"Mass number"
],
answer:2
},

{
q:"What is 3 × 4 + 2?",
options:["14","20","10","18"],
answer:0
},

{
q:"Which organelle is mainly responsible for aerobic respiration?",
options:["Ribosome","Nucleus","Mitochondrion","Vacuole"],
answer:2
},

{
q:"Which quantity is measured in volts?",
options:["Current","Resistance","Potential difference","Power"],
answer:2
}

];

let currentQuestion=0;
let quizScore=0;
let answered=false;


function loadQuiz(){

let q=quizQuestions[currentQuestion];

document.getElementById("quizNumber").innerText =
`Question ${currentQuestion+1} of ${quizQuestions.length}`;

document.getElementById("quizContent").innerHTML=`

<div class="question">${q.q}</div>

${q.options.map((option,i)=>`

<button class="option" onclick="answerQuiz(${i},this)">
${String.fromCharCode(65+i)}. ${option}
</button>

`).join("")}

<div id="quizFeedback"></div>

`;

answered=false;

}


function answerQuiz(index,button){

if(answered)return;

answered=true;

let q=quizQuestions[currentQuestion];

if(index===q.answer){

button.classList.add("correct");

quizScore++;

document.getElementById("quizFeedback").innerHTML=
`<p style="color:#00a67d;font-weight:700;margin-top:15px">
✓ Correct!
</p>`;

}else{

button.classList.add("wrong");

document.querySelectorAll(".option")[q.answer]
.classList.add("correct");

document.getElementById("quizFeedback").innerHTML=
`<p style="color:#d33;font-weight:700;margin-top:15px">
✗ Not quite. Review the concept and try again.
</p>`;

}

setTimeout(()=>{

currentQuestion++;

if(currentQuestion<quizQuestions.length){

loadQuiz();

}else{

finishQuiz();

}

},900);

}


function finishQuiz(){

let percentage=
Math.round((quizScore/quizQuestions.length)*100);

let previous=parseInt(localStorage.getItem("quizCount")||0);

localStorage.setItem("quizCount",previous+1);

localStorage.setItem("lastScore",percentage);

document.getElementById("quizContent").innerHTML=`

<div style="text-align:center;padding:30px">

<div style="font-size:70px">🏆</div>

<h2>Quiz Complete!</h2>

<p style="font-size:45px;font-weight:800;margin:20px">
${percentage}%
</p>

<p style="color:var(--muted)">
You scored ${quizScore} out of ${quizQuestions.length}.
</p>

<button class="btn btn-blue" onclick="restartQuiz()">
Try Again
</button>

</div>
`;

document.getElementById("quizNumber").innerText="Completed";

updateStats();

}


function restartQuiz(){

currentQuestion=0;
quizScore=0;
loadQuiz();

}


/* =========================
   NAVIGATION
========================= */

function showPage(page,button){

document.querySelectorAll(".page").forEach(p=>{
p.classList.remove("active");
});

let target=document.getElementById(page);

if(target)target.classList.add("active");

document.querySelectorAll(".nav button").forEach(b=>{
b.classList.remove("active");
});

if(button)button.classList.add("active");

document.getElementById("sidebar").classList.remove("open");

window.scrollTo({top:0,behavior:"smooth"});

if(page==="quiz")loadQuiz();

}


/* =========================
   SUBJECT
========================= */

function openSubject(name){

showPage("materials");

let matching=lessons.filter(l=>l.subject===name);

document.getElementById("lessonGrid").innerHTML=

matching.length?

matching.map(l=>`

<div class="lesson">

<div style="font-size:30px">${l.icon}</div>

<small style="color:var(--primary)">${l.subject}</small>

<h3>${l.title}</h3>

<p>${l.description}</p>

<button onclick="openLesson('${l.title}')">
Read Notes
</button>

</div>

`).join("")

:

`<div class="card">

<h2>${name} Materials</h2>

<p style="color:var(--muted);margin-top:10px">
More lessons and examination materials can be added to this subject.
</p>

</div>`;

}


/* =========================
   SEARCH
========================= */

function searchSite(){

let term=document.getElementById("searchInput")
.value.toLowerCase();

if(!term)return;

let found=lessons.find(l=>
l.title.toLowerCase().includes(term) ||
l.subject.toLowerCase().includes(term)
);

if(found){

showPage("materials");

document.getElementById("lessonGrid").innerHTML=`

<div class="lesson">

<div style="font-size:35px">${found.icon}</div>

<small>${found.subject}</small>

<h3>${found.title}</h3>

<p>${found.description}</p>

<button onclick="openLesson('${found.title}')">
Open Notes
</button>

</div>
`;

}

}


/* =========================
   DARK MODE
========================= */

function toggleDark(){

document.body.classList.toggle("dark");

localStorage.setItem(
"darkMode",
document.body.classList.contains("dark")
);

}

if(localStorage.getItem("darkMode")==="true"){
document.body.classList.add("dark");
}


/* =========================
   ACCESSIBILITY
========================= */

let fontSize=16;

function changeFont(amount){

fontSize+=amount;

if(fontSize<13)fontSize=13;
if(fontSize>23)fontSize=23;

document.documentElement.style.fontSize=fontSize+"px";

}

function toggleAccessibility(){

document.getElementById("accessPanel")
.classList.toggle("show");

}


/* =========================
   MOBILE MENU
========================= */

function toggleSidebar(){

document.getElementById("sidebar")
.classList.toggle("open");

}


/* =========================
   MODALS
========================= */

function closeModal(id){

document.getElementById(id)
.classList.remove("show");

}


/* =========================
   TOAST
========================= */

function showToast(message){

let toast=document.getElementById("toast");

toast.innerText=message;

toast.classList.add("show");

setTimeout(()=>{
toast.classList.remove("show");
},2500);

}


/* =========================
   LOGIN
========================= */

function login(){

let name=document.getElementById("loginName").value.trim();

if(!name){

showToast("Please enter your name.");

return;

}

localStorage.setItem("studentName",name);

document.getElementById("userName")
.innerText=name.split(" ")[0];

document.getElementById("loginScreen")
.style.display="none";

showToast("Welcome to StudyMate, "+name+"!");

}


function logout(){

localStorage.removeItem("studentName");

document.getElementById("loginScreen")
.style.display="flex";

}


/* =========================
   STATISTICS
========================= */

function updateStats(){

let count=
parseInt(localStorage.getItem("quizCount")||0);

let score=
parseInt(localStorage.getItem("lastScore")||0);

document.getElementById("quizStat").innerText=count;

document.getElementById("scoreStat").innerText=
score+"%";

document.getElementById("overallProgress").innerText=
score;

document.getElementById("overallBar").style.width=
score+"%";

}


function initializeUser(){

let saved=
localStorage.getItem("studentName");

if(saved){

document.getElementById("userName")
.innerText=saved.split(" ")[0];

document.getElementById("loginScreen")
.style.display="none";

}else{

document.getElementById("loginScreen")
.style.display="flex";

}

updateStats();

}

initializeUser();


/* =========================
   CLOSE MODALS
========================= */

document.querySelectorAll(".modal")
.forEach(modal=>{

modal.addEventListener("click",function(e){

if(e.target===modal){
modal.classList.remove("show");
}

});

});


</script>

</body>
